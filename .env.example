# =============================================================================
# KARAKS STORAGE — variables d'environnement (CDS 30)
# Copiez ce fichier vers .env. Ne committez jamais .env (CDS 24).
# =============================================================================

# --- Base de données ---------------------------------------------------------
# En développement : `npm run db:start`, puis le port donné par `npm run db:status`.
DATABASE_URL="postgres://postgres:postgres@localhost:51222/template1?sslmode=disable"
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51223/template1?sslmode=disable"
DATABASE_POOL_MAX=1

# --- Application -------------------------------------------------------------
APP_URL="http://localhost:3200"

# --- Secrets -----------------------------------------------------------------
# Générez chaque valeur avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Sessions du tableau de bord.
BETTER_AUTH_SECRET=
# Empreinte des clés API et des jetons de liens temporaires.
API_SECRET=
# Chiffrement du jeton Google Drive et des secrets de webhooks. Le changer rend
# illisibles les jetons déjà enregistrés : il faudrait reconnecter Google Drive.
ENCRYPTION_KEY=

# --- Google (connexion au tableau de bord et Google Drive) -------------------
# Console Google Cloud > API et services > Identifiants > ID client OAuth (Web).
# URI de redirection autorisées :
#   <APP_URL>/api/v1/auth/callback/google         (connexion)
#   <APP_URL>/api/v1/storage/google/callback    (Google Drive)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Facultatif : jeton obtenu hors de l'interface. Sinon, utilisez le bouton
# « Connecter Google Drive » des réglages, qui l'enregistre chiffré en base.
GOOGLE_REFRESH_TOKEN=
# Facultatif : dossier racine existant. Sinon, « KARAKS STORAGE » est créé.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Tâche planifiée --------------------------------------------------------
# Vercel l'envoie à /api/cron/maintenance (Authorization: Bearer …). Générez-le
# comme les autres secrets, et déclarez-le aussi dans Vercel.
CRON_SECRET=

# --- Limitation de débit partagée (CDS 25) ------------------------------------
# Sur Vercel, plusieurs instances servent les requêtes : sans compteur commun,
# chacune applique la limite pour elle seule. Une base Redis Upstash gratuite
# suffit (console.upstash.com, onglet REST API). Vide : compteur en mémoire.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Limites (CDS 25) --------------------------------------------------------
# Taille maximale d'un fichier, en octets, tous projets confondus.
STORAGE_MAX_FILE_SIZE=524288000
# Disque local : réservé au développement et aux tests.
LOCAL_STORAGE_DIR="./storage-data"
STORAGE_ALLOW_LOCAL=true

# --- Courriels -----------------------------------------------------------------
# Confirmation d'adresse, mot de passe oublié, invitations, alertes de sécurité
# et d'exploitation. Vide en développement : chaque message est écrit dans le
# journal du serveur.
#
# Avec Gmail : SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER = l'adresse Gmail, SMTP_PASSWORD = un mot de passe d'application
# (Compte Google > Sécurité > Validation en deux étapes > Mots de passe des
# applications), jamais le mot de passe du compte. Gmail impose l'adresse du
# compte comme expéditeur : seul le nom affiché de MAIL_FROM est repris.
# Limite : 500 emails par jour.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Karaks Storage <ne-pas-repondre@karaks.local>"
# Fuseau des dates écrites dans les emails.
APP_TIMEZONE=Indian/Antananarivo
